# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Data caches (raw pulls + joined master; recomputable via scripts/pull_data.py)
data/raw/*.parquet
data/raw/*.csv
data/raw/*.json
data/processed/*.parquet
data/processed/*.csv
data/cache/
!data/raw/.gitkeep
!data/cache/.gitkeep
!data/processed/.gitkeep

# Results (regenerated by pipeline)
results/**/*.parquet
results/**/*.csv
results/**/*.pkl
results/**/*.png
!results/**/.gitkeep

# Secrets and creds
.env
.env.local
*.key
credentials.json
secrets/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
logs/

# Notebooks
.ipynb_checkpoints/
notebooks/scratch/

# Big binaries (owner enforces no-binary rule)
*.pt
*.pth
*.h5
*.pkl.gz
*.tar
*.zip
